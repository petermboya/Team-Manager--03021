# Copy this file to .env and fill in the values from Firebase
# (Project settings -> Your apps -> your web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: address of a hosted json-server. Leave empty on GitHub Pages
# to run in demo mode (data saved in the browser).
# VITE_API_URL=https://your-api.example.com
